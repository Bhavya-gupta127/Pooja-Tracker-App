<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_longer"
    android:orientation="vertical"
    tools:context=".PoojaAddActivity">

    <!-- Pinned Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackAdd"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/card_surface"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/card_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Manage Poojas"
            android:textColor="@color/add_header_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

        <!-- Legacy Old-App Playlist Recovery Card (Zero Permissions / Play-Protect Safe) -->
        <LinearLayout
            android:id="@+id/legacyRecoveryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_today_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recover Playlist from Old App"
                android:textColor="@color/card_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/legacyRecoveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Old app Export broken? Screen-record (or screenshot) Monday–Sunday in your old 'Pooja Scheduler' app, then select the video/screenshots below!"
                android:textColor="@color/card_text_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMigrateOldApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/gradientbtn"
                android:text="Import Screen Video / Screenshots"
                android:textAllCaps="false"
                android:textColor="@color/gradient_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLoadStarterPack"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_secondary_surface"
                android:text="Load Saved 48-Pooja Base Pack (1-Tap)"
                android:textAllCaps="false"
                android:textColor="@color/secondary_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 1: Add New Pooja -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Custom Pooja"
                android:textColor="@color/card_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Add any YouTube mantra, aarti, or chalisa to your weekly schedule."
                android:textColor="@color/card_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/addTitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/add_input_box"
                android:hint="Pooja Title (e.g. Ganesh Mantra)"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/addDescription"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/add_input_box"
                android:hint="Description (optional)"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/addContentUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/add_input_box"
                android:hint="YouTube Video Link or 11-char ID"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />

            <!-- Select Days Header + Select All Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/addDaysText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Days"
                    android:textColor="@color/card_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selectAllDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:text="Select All"
                    android:textColor="@color/accent_link"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Day Checkboxes Row 1: Mon - Thu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <CheckBox
                    android:id="@+id/checkmonday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Mon"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checktuesday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Tue"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkWednesday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Wed"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkThursday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Thu"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Day Checkboxes Row 2: Fri - Sun -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <CheckBox
                    android:id="@+id/checkFriday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Fri"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkSaturday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Sat"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkSunday"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/checkbox_tint"
                    android:text="Sun"
                    android:textColor="@color/card_text_primary"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/submitData"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/gradientbtn"
                android:text="Add Pooja to Schedule"
                android:textAllCaps="false"
                android:textColor="@color/gradient_btn_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Playlist Backup & Sync -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playlist Backup &amp; Sync"
                android:textColor="@color/card_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addJsontext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Import a playlist from a JSON link or local file, or export your schedule to Downloads."
                android:textColor="@color/card_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/addJsonUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/add_input_box"
                android:hint="Paste JSON Playlist URL"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="https://raw.githubusercontent.com/Bhavya-gupta127/Pooja-Tracker-App/master/PoojaList.json"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submitJSON"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/gradientbtn"
                    android:text="Import URL"
                    android:textAllCaps="false"
                    android:textColor="@color/gradient_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/importFileJSON"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary_surface"
                    android:text="Import File"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/exportJSON"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_secondary_surface"
                android:text="Export Schedule to Downloads"
                android:textAllCaps="false"
                android:textColor="@color/secondary_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>